<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_matrix_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ماتریس آیزنهاور" android:textColor="#24212A" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:id="@+id/widget_matrix_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="امروز" android:textColor="#726D78" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_matrix_add" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="+" android:textColor="#55418D" android:textSize="24sp" android:contentDescription="افزودن یادآور" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:background="@drawable/widget_quadrant_urgent" android:orientation="vertical" android:padding="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فوری و مهم" android:textColor="#A12622" android:textStyle="bold" android:textSize="11sp" />
                <LinearLayout android:id="@+id/widget_tasks_urgent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginTop="4dp" android:background="@drawable/widget_quadrant_normal" android:orientation="vertical" android:padding="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فوری و کم‌اهمیت" android:textColor="#245B8F" android:textStyle="bold" android:textSize="11sp" />
                <LinearLayout android:id="@+id/widget_tasks_normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:background="@drawable/widget_quadrant_high" android:orientation="vertical" android:padding="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مهم و غیرفوری" android:textColor="#875500" android:textStyle="bold" android:textSize="11sp" />
                <LinearLayout android:id="@+id/widget_tasks_high" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:background="@drawable/widget_quadrant_low" android:orientation="vertical" android:padding="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نه فوری، نه مهم" android:textColor="#246B39" android:textStyle="bold" android:textSize="11sp" />
                <LinearLayout android:id="@+id/widget_tasks_low" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
